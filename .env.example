# Copy to .env (git-ignored) and `set -a; source .env; set +a` before running.
# The inventory stores only *references* (credential_ref=env:NAME); values live here
# or, preferably, in a secrets manager.

SPIKERZ_QA_DB=data/spikerz_qa.db
SPIKERZ_QA_ACTOR=your.name
SPIKERZ_QA_PROVIDER=auto            # auto (each account's own provider) | mock | live

# Optional: Slack/Teams incoming webhook for alerts
SPIKERZ_QA_ALERT_WEBHOOK=

# Live provider only - one token per account, named to match credential_ref
META_APP_ACCESS_TOKEN=              # app token used for Graph API debug_token
SPIKERZ_QA_LI_001_TOKEN=
SPIKERZ_QA_FB_001_TOKEN=
SPIKERZ_QA_IG_001_TOKEN=
SPIKERZ_QA_TT_001_TOKEN=
SPIKERZ_QA_XX_001_TOKEN=

